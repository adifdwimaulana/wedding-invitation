---
/**
 * Inline SVG icons. Kept in one place so stroke width and viewBox stay
 * consistent, and so no icon font or sprite request is needed.
 */
export type IconName =
  | 'instagram'
  | 'calendar'
  | 'pin'
  | 'gift'
  | 'share'
  | 'close'
  | 'music'
  | 'heart'
  | 'image'
  | 'list';

interface Props {
  name: IconName;
  width?: number;
}

const { name, width = 1.6 } = Astro.props;
---

<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width={width} aria-hidden="true">
  {name === 'instagram' && (
    <>
      <rect x="2.5" y="2.5" width="19" height="19" rx="5" />
      <circle cx="12" cy="12" r="4.2" />
      <circle cx="17.4" cy="6.6" r="1.1" fill="currentColor" stroke="none" />
    </>
  )}

  {name === 'calendar' && (
    <>
      <rect x="3" y="5" width="18" height="16" rx="2" />
      <path d="M3 10h18M8 3v4M16 3v4" />
    </>
  )}

  {name === 'pin' && (
    <>
      <path d="M12 21s7-6.4 7-11a7 7 0 1 0-14 0c0 4.6 7 11 7 11z" />
      <circle cx="12" cy="10" r="2.6" />
    </>
  )}

  {name === 'gift' && (
    <>
      <rect x="3" y="8" width="18" height="13" rx="1.5" />
      <path d="M3 12h18M12 8v13" />
      <path d="M12 8S9.6 3.6 7.4 4.4C5.6 5 6 8 8.2 8M12 8s2.4-4.4 4.6-3.6C18.4 5 18 8 15.8 8" />
    </>
  )}

  {name === 'share' && (
    <>
      <circle cx="18" cy="5.5" r="2.6" />
      <circle cx="6" cy="12" r="2.6" />
      <circle cx="18" cy="18.5" r="2.6" />
      <path d="M15.7 6.8L8.3 10.7M8.3 13.3l7.4 3.9" />
    </>
  )}

  {name === 'close' && <path d="M5 5l14 14M19 5L5 19" />}

  {name === 'music' && (
    <>
      <circle cx="12" cy="12" r="8.5" />
      <circle cx="12" cy="12" r="2" fill="currentColor" stroke="none" />
      <path d="M12 3.5v3M12 17.5v3M3.5 12h3M17.5 12h3" />
    </>
  )}

  {name === 'heart' && <path d="M12 20.5s-7-4.4-7-9.3A4.2 4.2 0 0 1 12 8a4.2 4.2 0 0 1 7 3.2c0 4.9-7 9.3-7 9.3z" />}

  {name === 'image' && (
    <>
      <rect x="3.5" y="4.5" width="17" height="15" rx="2" />
      <circle cx="9" cy="10" r="1.6" />
      <path d="M4 17l4.5-4.5L13 17M12.5 16l3-3 5 4" />
    </>
  )}

  {name === 'list' && (
    <>
      <path d="M8 6h11M8 12h11M8 18h11" />
      <path d="M3.2 6l1.4 1.4L7 5" />
      <path d="M3.2 12l1.4 1.4L7 11" />
      <path d="M3.2 18l1.4 1.4L7 17" />
    </>
  )}
</svg>

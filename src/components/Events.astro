---
import { wedding } from '../data/wedding';

const events = [
  { index: '01', title: 'Akad Nikah', time: wedding.akadTimeLabel },
  { index: '02', title: 'Resepsi', time: wedding.resepsiTimeLabel },
];
---

<section id="acara" class="section-pad">
  <div class="wrap">
    <div class="center reveal">
      <p class="label">Rangkaian Acara</p>
      <h2 class="h-sec">Waktu &amp; Tempat</h2>
      <div class="rule--short" aria-hidden="true"></div>
    </div>

    <div class="events" data-stagger="130">
      {events.map((event) => (
        <article class="event reveal">
          <p class="label">{event.index}</p>
          <h3>{event.title}</h3>
          <dl>
            <dt>Waktu</dt>
            <dd class="num">{event.time}</dd>
            <dt>Tanggal</dt>
            <dd>{wedding.dateLabel}</dd>
            <dt>Tempat</dt>
            <dd>{wedding.venue}</dd>
          </dl>
        </article>
      ))}
    </div>
  </div>
</section>
